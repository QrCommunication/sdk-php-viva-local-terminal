{
    "name": "qrcommunication/viva-local-terminal-sdk",
    "description": "PHP SDK for Viva.com Local Terminal API (/pos/v1/) — direct peer-to-peer (P2P) communication with EFT POS card terminals over the local network",
    "type": "library",
    "license": "MIT",
    "keywords": ["viva", "vivawallet", "vivacom", "local-terminal", "p2p", "eft-pos", "card-terminal", "payment", "pos", "sdk"],
    "authors": [
        {
            "name": "QrCommunication",
            "email": "contact@qrcommunication.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "QrCommunication\\VivaLocalTerminal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QrCommunication\\VivaLocalTerminal\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
